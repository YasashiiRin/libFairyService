{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.claude/**,.venv/**,**/__pycache__/**,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 20 * * *"
    }
  ]
}
