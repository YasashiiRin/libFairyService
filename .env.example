# Copy to .env (never commit it). `neon link` / `neon deploy` fill in the DATABASE_* values.

# development | production
ENVIRONMENT=development

# Neon pooled connection string (host contains "-pooler"). Used by the app.
# The libpq form from Neon is fine: sslmode/channel_binding are converted for asyncpg.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon direct (non-pooled) connection string: the same, without "-pooler". Used by Alembic migrations only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Prepared statements are reused on each connection (Neon's pooler supports it). false turns that off.
# DATABASE_PREPARED_STATEMENTS=true

# Deployed frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
# http://localhost:5173 and http://localhost:3000 are always allowed.
FRONTEND_URL=https://your-frontend.vercel.app

# Signs access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-characters-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Calendar day for reading logs and stats.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Search across the web: per-provider timeout, contact sent in the User-Agent (URL or email),
# and how long search results are cached.
PROVIDER_TIMEOUT_SECONDS=4
PROVIDER_CONTACT=https://your-frontend.vercel.app
SEARCH_CACHE_TTL_HOURS=6

# Protects /api/cron/daily (Vercel Cron sends it as a Bearer token). Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# The home feed "Khu vườn hôm nay": how long the first home request of the day may wait for the
# providers (the rest is added on the next request), how long later requests wait while it is still
# building, and the daily cron's time budget (keep it under vercel.json maxDuration, 60 s).
# FEED_BUILD_SECONDS=5
# FEED_RETRY_SECONDS=2
# CRON_BUDGET_SECONDS=40
